# Copy this file to .env and fill in real values. Never commit .env.

# --- Core -------------------------------------------------------------
SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata

# --- Database (production only; development always uses SQLite) --------
DB_NAME=teamtrack
DB_USER=teamtrack
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Email (production only; development prints to the console) --------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=TeamTrack <noreply@example.com>

# --- Application rules ------------------------------------------------
INVITATION_EXPIRY_DAYS=7
MAX_UPLOAD_SIZE_MB=10

# --- Google Forms integration (Phase 9; blank = feature stays dormant) -
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- Ether integration (Phase 10; blank = null client, no network calls)
ETHER_BASE_URL=
ETHER_API_KEY=
