# Copy to .env and fill in. Never commit .env itself.
#
#   Windows:  Copy-Item .env.example .env
#   Linux:    cp .env.example .env

# --- Core -----------------------------------------------------------------
# Generate a fresh one, do not reuse this placeholder:
#   python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(60)))"
SECRET_KEY=replace-me-with-60-random-characters
DEBUG=True
TIME_ZONE=Asia/Kolkata

# Development accepts any host by default, so this does not need editing when
# your IP changes. Production requires it (or Railway's RAILWAY_PUBLIC_DOMAIN).
# ALLOWED_HOSTS=teamtrack.example.com

# --- Database -------------------------------------------------------------
# Development uses SQLite and needs nothing here.
# Production wants DATABASE_URL. On Railway set it to the literal reference:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_URL=postgres://user:password@host:5432/teamtrack

# --- Email ----------------------------------------------------------------
# Development prints emails to the terminal. Nothing here is needed to test
# the invitation flow locally.
#
# In production, prefer the HTTP API. Railway, Render and Fly block outbound
# SMTP ports, so smtp.gmail.com fails there with "Connection refused" however
# correct your credentials are. Brevo's API runs over HTTPS and is not blocked.
# BREVO_API_KEY=xkeysib-...
DEFAULT_FROM_EMAIL=TeamTrack <no-reply@example.com>

# SMTP instead, for a plain VPS where port 587 is open. Ignored whenever
# BREVO_API_KEY is set.
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# --- Uploaded files -------------------------------------------------------
# Development stores uploads in media/. Managed hosts wipe the container disk
# on every deploy, so production needs object storage or files are lost.
# Leave AWS_STORAGE_BUCKET_NAME empty to keep using the local disk.
# AWS_STORAGE_BUCKET_NAME=teamtrack-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# --- First administrator --------------------------------------------------
# `manage.py bootstrap_admin` creates this account if it does not exist, then
# does nothing on later runs. Delete ADMIN_PASSWORD once the account exists.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=at-least-twelve-characters
ADMIN_NAME=Administrator

# --- Invitations ----------------------------------------------------------
INVITATION_EXPIRY_DAYS=7

# --- Uploads --------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10

# --- Attendance -----------------------------------------------------------
# Longest a single sign-in session can count for. A forgotten sign-out is
# capped at this instead of becoming a 40-hour day.
ATTENDANCE_MAX_HOURS=9

# --- Google Forms (optional, not configured yet) --------------------------
# The app runs normally without these.
# GOOGLE_SERVICE_ACCOUNT_FILE=
# GOOGLE_SHEETS_ENABLED=False

# --- Ether (optional, no API published yet) -------------------------------
# ETHER_ENABLED=False
# ETHER_BASE_URL=
# ETHER_API_KEY=
